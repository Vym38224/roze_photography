ErrorDocument 404 /404.html

# Lokalni konfigurace nesmi byt verejne dostupna
<FilesMatch "^admin-config\.php$">
    Require all denied
</FilesMatch>

# Zapnutí kešování obrázků a statických souborů na 1 rok (WEDOS Apache)
<IfModule mod_expires.c>
    ExpiresActive On

    # Obrázky (AVIF, WEBP, JPG, PNG, SVG)
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # Styly, skripty a fonty
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(avif|webp|jpe?g|png|svg)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>

# Administrace i verejny web musi bezet pouze pres HTTPS.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Přesměrování starých podstránek na odpovídající sekce nového webu
Redirect 301 /o-mne.html https://rozephotography.cz/index.html#o_mne
Redirect 301 /kontakty.html https://rozephotography.cz/index.html#kontakty
Redirect 301 /cenik.html https://rozephotography.cz/index.html#nabidka